#!/usr/bin/env python3

import argparse
import subprocess
from pathlib import Path
from urllib.parse import urlsplit

REMOTE_PATH_FORMATS = {
    "github.com": "{path}.git",
    "gitlab.com": "{path}.git",
    "codeberg.org": "{path}.git",
    "gist.github.com": "{path}.git",
    "git.sr.ht": "~{path}",
}


def expand_url(url: str) -> str:
    """Expand a shorthand URL to a full clone URL."""
    url = url.rstrip("/")

    if url.startswith(("https://", "git@", "ssh://")):
        return url

    if "/" not in url:
        return f"https://github.com/srstevenson/{url}"

    head, tail = url.split("/", maxsplit=1)

    if "." in head:
        # Assume `head` is a hostname if it contains `.`.
        return f"https://{head}/{tail}"

    return f"https://github.com/{url}"


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Clone Git repositories into ~/Projects"
    )
    parser.add_argument(
        "url",
        type=parse_repository,
        help="remote URL or GitHub shorthand (`project` or `user/project`)",
    )
    return parser.parse_args()


def resolve_repository(url: str) -> tuple[str, str, str]:
    """Resolve an expanded URL to a clone URL, host, and local repository path."""
    # Convert SCP-style syntax for parsing without changing the supplied URL.
    remote = urlsplit(
        "ssh://" + url.replace(":", "/", 1) if url.startswith("git@") else url
    )
    host = remote.hostname
    if host is None or not remote.path.strip("/"):
        message = "Expected a hostname and repository path"
        raise ValueError(message)

    path = remote.path.lstrip("/").lstrip("~").removesuffix(".git")
    owner = path.partition("/")[0]
    use_ssh = remote.scheme == "ssh" or owner == "srstevenson"

    if host == "gist.github.com":
        path = path.rsplit("/", maxsplit=1)[-1]

    if host in REMOTE_PATH_FORMATS:
        remote_path = REMOTE_PATH_FORMATS[host].format(path=path)
        if url.startswith("ssh://"):
            # Preserve explicit SSH users and ports.
            url = remote._replace(path=f"/{remote_path}").geturl()
        elif use_ssh:
            url = f"git@{host}:{remote_path}"
        else:
            url = f"https://{host}/{remote_path}"

    return url, host, path


def parse_repository(value: str) -> tuple[str, str, str]:
    """Convert repository input, reporting invalid URLs as argument errors."""
    try:
        return resolve_repository(expand_url(value))
    except ValueError as error:
        raise argparse.ArgumentTypeError(str(error)) from error


def main() -> int:
    """Command-line entry point."""
    args = parse_args()

    url, host, repository_path = args.url
    path = Path(repository_path)
    path = path.with_name(path.name.lstrip("."))

    return subprocess.run(  # noqa: S603
        [  # noqa: S607
            "git",
            "clone",
            "--recurse-submodules",
            url,
            Path.home().joinpath("Projects", host, path),
        ],
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(main())
