#!/usr/bin/env python3

import argparse
import os
import webbrowser
from urllib.parse import urlencode

DUCKDUCKGO_PARAMS = {
    "kac": "-1",
    "kae": "-1",
    "k1": "-1",
    "kaj": "m",
    "kat": "-1",
    "kak": "-1",
    "kax": "-1",
    "kaq": "-1",
    "kao": "-1",
    "kau": "-1",
    "kpsb": "-1",
}


def main() -> None:
    """Open DuckDuckGo search for a query in the browser."""
    parser = argparse.ArgumentParser(description="Search DuckDuckGo")
    parser.add_argument("query", nargs="+", help="search query")
    args = parser.parse_args()

    params = {"q": " ".join(args.query)}
    params.update(DUCKDUCKGO_PARAMS)
    url = f"https://duckduckgo.com/?{urlencode(params)}"
    print(url)
    if "SSH_CONNECTION" not in os.environ:
        webbrowser.open(url)


if __name__ == "__main__":
    main()
