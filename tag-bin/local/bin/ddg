#!/usr/bin/env python3

"""Search DuckDuckGo in the browser."""

import argparse
import webbrowser
from urllib.parse import urlencode

PARAMS = {
    "k1": "-1",  # No adverts.
    "kak": "-1",  # No browser installation instructions.
    "kao": "-1",  # No homepage privacy tips.
    "kap": "-1",  # No newletter reminders.
    "kaq": "-1",  # No newsletter sign-up forms.
    "kau": "-1",  # No feedback requests.
    "kax": "-1",  # No reminders to add to the browser.
    "kbe": "0",  # No AI generated answers.
    "kbg": "-1",  # No Duck.ai buttons and links.
    "kbi": "1",  # Compact results.
    "kbj": "1",  # No AI generated images.
    "kbl": "0",  # No AI generated follow-up questions.
    "kpsb": "-1",  # No protected search reminder.
    "kz": "-1",  # No Instant Answers.
}


def main() -> None:
    """Open DuckDuckGo search for a query in the browser."""
    parser = argparse.ArgumentParser(description="Search DuckDuckGo")
    parser.add_argument("query", nargs="+", help="search query")
    args = parser.parse_args()

    params = {"q": " ".join(args.query)}
    params.update(PARAMS)
    webbrowser.open(f"https://duckduckgo.com/?{urlencode(params)}")


if __name__ == "__main__":
    main()
